# macOS
.DS_Store

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo

# Python (HA custom integration, scripts)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / pnpm (Mac app frontend)
node_modules/
dist/
.turbo/
.next/
.cache/

# Rust (Tauri backend)
target/
**/*.rs.bk
Cargo.lock

# Tauri build outputs
src-tauri/target/
src-tauri/gen/

# Secrets (must never be committed)
.env
.env.*
!.env.example
secrets.yaml
# Editor / shell backup copies of secrets — caught by the niggly-bits
# audit. `secrets.yaml.bak` had real Wi-Fi creds and was missing from
# the ignore list.
secrets.yaml.*
*.local
# Editor backup files in general — keep them out of the tree.
*.bak

# OS / log clutter
*.log
.coverage

# Local ESPHome build state (secrets, PlatformIO cache)
esphome/secrets.yaml
esphome/.esphome/
esphome/build/
