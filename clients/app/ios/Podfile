# NOTE: clients/app/package.json pins react-native-worklets@0.8.3 (NOT
# 0.9.x). audio-api 0.12.2 says worklets is an optional peer; in
# practice the audio-api podspec raises `Pathname.relative_path_from
# different prefix` if worklets is absent. Worklets 0.9.x asserts RN
# 0.83+ at the pod level (we're on RN 0.81.6). scripts/check-pin-bounds.sh
# enforces the 0.8.x band. Sasha M21 N1 — doc here so a future cleanup
# doesn't drop the pin.

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'voix' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end

# voix keyboard extension (M24). Pure Swift/SwiftUI, NO React Native
# runtime — keyboard extensions have a ~48 MB memory budget and Apple
# rejects keyboards that ship a JS engine. Block exists so pod install
# treats VoixKeyboard as a known target; no actual pods are linked.
target 'VoixKeyboard' do
end
