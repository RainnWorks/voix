"""Integration tests for the per-device VoixModeSelect entity.

What's covered:
  - Entity created when a device is in entry.options[discovered_devices] at setup
  - Entity created on the fly when SIGNAL_DEVICE_DISCOVERED fires
  - async_select_option fires EVENT_MODE_CHANGED with the right payload
  - cycle() rotates through the option list (wraps)
  - refresh_options picks up adds + falls back to default when current vanishes
  - RestoreEntity reads last_state and applies it on add
"""
from __future__ import annotations

from typing import Any

import pytest

from custom_components.voix.const import (
    CONF_DEFAULT_MODE,
    CONF_MODES,
    DEFAULT_MODES,
    DOMAIN,
    EVENT_MODE_CHANGED,
)

pytestmark = pytest.mark.enable_custom_integrations

DEVICE_ID = "home-assistant-voice-095e4e"
EXPECTED_SLUG = "home_assistant_voice_095e4e"
EXPECTED_ENTITY_ID = f"select.voix_mode_{EXPECTED_SLUG}"


async def _setup_with_device(hass: Any, mock_config_entry) -> None:
    """Common helper: configure an entry that already has one discovered device."""
    new_options = {
        **mock_config_entry.options,
        "discovered_devices": {DEVICE_ID: {"friendly_name": "Kitchen"}},
    }
    mock_config_entry.add_to_hass(hass)
    hass.config_entries.async_update_entry(mock_config_entry, options=new_options)
    assert await hass.config_entries.async_setup(mock_config_entry.entry_id)
    await hass.async_block_till_done()


async def test_select_entity_created_for_discovered_device(
    hass: Any, mock_config_entry
) -> None:
    """Given a discovered device on first setup, When the entry loads, Then a select entity exists with mode-id options."""
    await _setup_with_device(hass, mock_config_entry)
    state = hass.states.get(EXPECTED_ENTITY_ID)
    assert state is not None
    # Options come from the mode catalog.
    assert set(state.attributes["options"]) == set(DEFAULT_MODES.keys())


async def test_select_entity_created_on_discovery_signal(
    hass: Any, mock_config_entry
) -> None:
    """Given an entry with no devices, When the discovery signal fires, Then a select is added live."""
    mock_config_entry.add_to_hass(hass)
    assert await hass.config_entries.async_setup(mock_config_entry.entry_id)
    await hass.async_block_till_done()

    assert hass.states.get(EXPECTED_ENTITY_ID) is None
    # Use the persisted register_device callback (it dispatches the signal).
    register = hass.data[DOMAIN]["register_device"]
    register(DEVICE_ID, "Kitchen")
    await hass.async_block_till_done()

    assert hass.states.get(EXPECTED_ENTITY_ID) is not None


async def test_select_initial_option_is_default_mode(
    hass: Any, mock_config_entry
) -> None:
    """Given default_mode=default-realtime, When the select is created, Then current_option is default-realtime."""
    mock_config_entry.add_to_hass(hass)
    hass.config_entries.async_update_entry(
        mock_config_entry,
        options={
            **mock_config_entry.options,
            CONF_DEFAULT_MODE: "default-realtime",
            "discovered_devices": {DEVICE_ID: {"friendly_name": "Kitchen"}},
        },
    )
    assert await hass.config_entries.async_setup(mock_config_entry.entry_id)
    await hass.async_block_till_done()

    state = hass.states.get(EXPECTED_ENTITY_ID)
    assert state.state == "default-realtime"


async def test_async_select_option_fires_event_mode_changed(
    hass: Any, mock_config_entry
) -> None:
    """Given the select on default-assist, When set to default-realtime, Then EVENT_MODE_CHANGED fires with full payload."""
    await _setup_with_device(hass, mock_config_entry)

    events: list = []

    @callback_decorator()
    def _capture(event):
        events.append(event)

    hass.bus.async_listen(EVENT_MODE_CHANGED, _capture)

    await hass.services.async_call(
        "select",
        "select_option",
        {"entity_id": EXPECTED_ENTITY_ID, "option": "default-realtime"},
        blocking=True,
    )
    await hass.async_block_till_done()

    assert len(events) == 1
    data = events[0].data
    assert data["entry_id"] == mock_config_entry.entry_id
    assert data["device_id"] == DEVICE_ID
    assert data["from"] == "default-assist"
    assert data["to"] == "default-realtime"


async def test_setting_same_option_is_noop(hass: Any, mock_config_entry) -> None:
    """Given current_option is X, When selecting X again, Then no EVENT_MODE_CHANGED fires."""
    await _setup_with_device(hass, mock_config_entry)
    events: list = []
    hass.bus.async_listen(EVENT_MODE_CHANGED, lambda e: events.append(e))

    current = hass.states.get(EXPECTED_ENTITY_ID).state
    await hass.services.async_call(
        "select",
        "select_option",
        {"entity_id": EXPECTED_ENTITY_ID, "option": current},
        blocking=True,
    )
    await hass.async_block_till_done()
    assert events == []


async def test_unknown_option_is_rejected(hass: Any, mock_config_entry) -> None:
    """Given an option not in the catalog, When attempted, Then HA's select schema rejects it."""
    await _setup_with_device(hass, mock_config_entry)
    # HA's select service raises ServiceValidationError for an unknown option;
    # the entity's own guard is a second line of defence. Either way: no change.
    prev = hass.states.get(EXPECTED_ENTITY_ID).state
    with pytest.raises(Exception):
        await hass.services.async_call(
            "select",
            "select_option",
            {"entity_id": EXPECTED_ENTITY_ID, "option": "totally-bogus"},
            blocking=True,
        )
    assert hass.states.get(EXPECTED_ENTITY_ID).state == prev


async def test_cycle_method_wraps(hass: Any, mock_config_entry) -> None:
    """Given the select.cycle() helper, When called repeatedly, Then it walks the option list and wraps."""
    await _setup_with_device(hass, mock_config_entry)
    ent = hass.data[DOMAIN]["mode_select"][DEVICE_ID]
    opts = ent._attr_options
    start_idx = opts.index(ent.current_option)
    expected = opts[(start_idx + 1) % len(opts)]
    assert ent.cycle() == expected


async def test_refresh_options_picks_up_new_mode(
    hass: Any, mock_config_entry
) -> None:
    """Given a select with N options, When a new mode is added to options, Then refresh_options exposes N+1."""
    await _setup_with_device(hass, mock_config_entry)
    ent = hass.data[DOMAIN]["mode_select"][DEVICE_ID]
    before = list(ent._attr_options)

    new_modes = dict(mock_config_entry.options[CONF_MODES])
    new_modes["custom"] = {
        "name": "Custom",
        "type": "realtime",
        "prompt": "",
        "voice": "alloy",
        "model": "gpt-realtime",
        "color": [10, 20, 30],
        "brightness": 0.4,
        "effect": "None",
    }
    hass.config_entries.async_update_entry(
        mock_config_entry,
        options={**mock_config_entry.options, CONF_MODES: new_modes},
    )
    await hass.async_block_till_done()

    after = list(ent._attr_options)
    assert "custom" in after
    assert len(after) == len(before) + 1


async def test_refresh_options_falls_back_when_current_deleted(
    hass: Any, mock_config_entry
) -> None:
    """Given current_option was deleted from the catalog, When refresh_options runs, Then current falls back to default_mode."""
    await _setup_with_device(hass, mock_config_entry)
    ent = hass.data[DOMAIN]["mode_select"][DEVICE_ID]
    # Force current to default-realtime so we can delete it.
    await ent.async_select_option("default-realtime")
    await hass.async_block_till_done()
    assert ent.current_option == "default-realtime"

    new_modes = dict(mock_config_entry.options[CONF_MODES])
    new_modes.pop("default-realtime")
    hass.config_entries.async_update_entry(
        mock_config_entry,
        options={**mock_config_entry.options, CONF_MODES: new_modes},
    )
    await hass.async_block_till_done()
    # Should fall back to default-assist (the entry's default_mode).
    assert ent.current_option == "default-assist"


async def test_restore_entity_recovers_last_state(
    hass: Any, mock_config_entry
) -> None:
    """Given a previously-saved last_state, When the entity is added, Then it restores that mode_id."""
    # Pre-seed the restore-state cache via the pytest-HA helper, which
    # handles both the legacy RestoreStateData API and the newer
    # RestoreEntity per-class storage.
    from homeassistant.core import State
    from pytest_homeassistant_custom_component.common import mock_restore_cache

    mock_restore_cache(hass, [State(EXPECTED_ENTITY_ID, "default-dictation")])

    await _setup_with_device(hass, mock_config_entry)
    state = hass.states.get(EXPECTED_ENTITY_ID)
    assert state.state == "default-dictation"


# ─── tiny callback-marker helper ─────────────────────────────────────────────


def callback_decorator():
    """Return HA's `callback` decorator if available, else identity."""
    try:
        from homeassistant.core import callback
        return callback
    except ImportError:
        return lambda f: f
