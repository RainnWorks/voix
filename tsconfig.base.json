{
  // Note: no `paths` map in this base. Path mappings resolve relative
  // to each tsconfig's own baseUrl, so a base-level map becomes dead
  // code the moment a leaf sets its own baseUrl. Each consuming
  // workspace declares its own `@voix/*` → `packages/.../src/index.ts`
  // paths instead (see voix-backend/ui/tsconfig.json,
  // packages/ui/tsconfig.json).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
