# OpenAI key (required) — used for STT + realtime sessions.
OPENAI_API_KEY=sk-...

# Shared secret pucks must present in their hello payload.
# Generate once with: openssl rand -hex 32
VOIX_WS_TOKEN=

# WS server listen port. Default 8765.
VOIX_PORT=8765

# Log level: trace | debug | info | warn | error
VOIX_LOG_LEVEL=info
